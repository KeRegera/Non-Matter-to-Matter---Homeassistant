{
  "name": "ha-matter-bridge",
  "version": "1.0.0",
  "description": "Exposes Home Assistant entities (also non-Matter devices) as Matter devices",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@matter/main": "0.17.9",
    "qrcode": "1.5.4",
    "werift": "0.24.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
